<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/gray_200"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/time_date_container"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/time_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/gray_900"
            android:textSize="60sp"
            android:textStyle="bold"
            tools:text="12:45" />

        <TextView
            android:id="@+id/date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/gray_700"
            android:textSize="16sp"
            tools:text="16/10/2025" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:layout_gravity="center"
        tools:ignore="RtlSymmetry"
        android:layout_marginEnd="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_new_task"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/eginbehar_home"
            app:endIconDrawable="@drawable/ic_add"
            app:endIconMode="custom"
            app:endIconTint="@color/gray_900">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_egitekoak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/gray_900"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="@string/eginbeharrekoak_btn"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_list"
            app:iconTint="@color/white" />

    </LinearLayout>

</LinearLayout>
